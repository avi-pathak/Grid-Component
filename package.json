{
  "name": "@avi-pathak/apgrid",
  "version": "0.1.6",
  "description": "A fast, virtualized data grid for the web. Renders millions of rows with a recycled DOM.",
  "license": "MIT",
  "author": "Avi Pathak",
  "homepage": "https://github.com/avi-pathak/Grid-Component#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi-pathak/Grid-Component.git"
  },
  "bugs": {
    "url": "https://github.com/avi-pathak/Grid-Component/issues"
  },
  "keywords": [
    "grid",
    "datagrid",
    "virtualized",
    "virtual-scroll",
    "table",
    "spreadsheet",
    "data-grid",
    "virtualization",
    "performance",
    "large-dataset",
    "react-grid",
    "component",
    "ui-component",
    "web-component",
    "DOM-recycling",
    "fast-rendering",
    "infinite-scroll",
    "table-component",
    "grid-library",
    "control",
    "ui",
    "control library",
    "component library",
    "ui library",
    "control-library",
    "component-library",
    "ui-library",
    "data grid"
  ],
  "main": "./dist/cjs/apgrid.cjs",
  "module": "./dist/esm/apgrid.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/apgrid.mjs",
      "require": "./dist/cjs/apgrid.cjs"
    },
    "./styles.css": "./dist/apgrid.css",
    "./styles-light.css": "./dist/apgrid-light.css",
    "./styles-dark.css": "./dist/apgrid-dark.css",
    "./scss/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "workspaces": [
    "examples"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:js && npm run build:themes && npm run build:types",
    "build:js": "webpack --config webpack.config.js",
    "build:themes": "sass --no-source-map --style=compressed src/styles/apgrid-light.scss:dist/apgrid-light.css src/styles/apgrid-dark.scss:dist/apgrid-dark.css",
    "build:types": "tsc -p tsconfig.build.json",
    "pack:examples": "npm run build && node scripts/pack-examples.js",
    "dev": "npm run pack:examples && npm run dev --workspace apgrid-demos",
    "dev:app": "npm run dev --workspace apgrid-demos",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "npm run pack:examples && npm run typecheck --workspace apgrid-demos",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "docs": "typedoc",
    "docs:serve": "typedoc && node -e \"const http=require('http'),fs=require('fs'),p=require('path'),d='docs-site';const t={'.html':'text/html','.js':'text/javascript','.css':'text/css','.json':'application/json','.svg':'image/svg+xml'};http.createServer((q,s)=>{let f=p.join(d,decodeURIComponent(q.url.split('?')[0]));if(f.endsWith('/'))f=p.join(f,'index.html');fs.readFile(f,(e,b)=>{if(e){s.writeCode=404;s.end('Not found');}else{s.setHeader('Content-Type',t[p.extname(f)]||'application/octet-stream');s.end(b);}});}).listen(4173,()=>console.log('Docs at http://localhost:4173'));\"",
    "format": "prettier --write \"src/**/*.{ts,scss}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepare": "husky || true",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.scss": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "css-loader": "^6.10.0",
    "css-minimizer-webpack-plugin": "^6.0.0",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.0.11",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.2",
    "mini-css-extract-plugin": "^2.8.1",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.10",
    "sass": "^1.101.0",
    "sass-loader": "^16.0.8",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
