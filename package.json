{
  "name": "@avi-pathak/apgrid",
  "version": "0.1.0",
  "description": "A fast, virtualized data grid for the web. Renders millions of rows with a recycled DOM.",
  "license": "MIT",
  "author": "Avi Pathak",
  "keywords": [
    "grid",
    "datagrid",
    "virtualized",
    "virtual-scroll",
    "table",
    "spreadsheet"
  ],
  "main": "./dist/cjs/apgrid.cjs",
  "module": "./dist/esm/apgrid.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/apgrid.mjs",
      "require": "./dist/cjs/apgrid.cjs"
    },
    "./styles.css": "./dist/apgrid.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:js && npm run build:types",
    "build:js": "webpack --config webpack.config.js",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "webpack serve --config webpack.dev.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "css-loader": "^6.10.0",
    "css-minimizer-webpack-plugin": "^6.0.0",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.0.11",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.2",
    "mini-css-extract-plugin": "^2.8.1",
    "prettier": "^3.2.5",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
